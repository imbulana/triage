# Provider selection: ollama or openai
LEANRAG_LLM_PROVIDER=ollama

# Ollama settings (used when LEANRAG_LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_QUERY_MODEL=gemma4:e2b
OLLAMA_GRAPH_BUILD_MODEL=gemma4:e2b
OLLAMA_EMBED_MODEL=embeddinggemma

# OpenAI settings (used when LEANRAG_LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_QUERY_MODEL=gpt-4.1-mini
OPENAI_GRAPH_BUILD_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=