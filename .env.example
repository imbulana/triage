# Provider selection: ollama or openai
LEANRAG_LLM_PROVIDER=ollama

# Ollama settings (used when LEANRAG_LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_QUERY_MODEL=gemma4:e2b
OLLAMA_GRAPH_BUILD_MODEL=gemma4:e2b
OLLAMA_EMBED_MODEL=embeddinggemma

# Runtime retrieval mode. Keep true for production/evaluation runs so the
# system fails instead of silently using local entity/chunk fallback retrieval.
TRIAGE_REQUIRE_LEANRAG=true

# Optional observability. Set TRIAGE_LANGFUSE=true or pass --langfuse on the
# orchestrator/evaluator command when these credentials are configured.
TRIAGE_LANGFUSE=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse SDKs use LANGFUSE_HOST; LANGFUSE_BASE_URL is accepted by our local
# TraceRecorder and mapped to LANGFUSE_HOST when LANGFUSE_HOST is unset.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Prompt/system prompt capture defaults to config.yaml trace.capture_llm_io.
# Set TRIAGE_TRACE_LLM_IO=false to suppress prompt bodies in traces.
TRIAGE_TRACE_LLM_IO=true
TRIAGE_TRACE_LLM_MAX_CHARS=24000

# OpenAI settings (used when LEANRAG_LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_QUERY_MODEL=gpt-4.1-mini
OPENAI_GRAPH_BUILD_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=
